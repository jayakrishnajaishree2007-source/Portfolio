{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and persistent 3D studio preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User display name from Google Sign-In."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified Google account email."
        },
        "preferredLighting": {
          "type": "string",
          "enum": ["cyan", "tungsten", "chrome"],
          "description": "Saved 3D studio lighting preset."
        },
        "preferredCameraMode": {
          "type": "string",
          "enum": ["scroll", "orbit", "hero"],
          "description": "Saved 3D camera interaction mode."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "preferredLighting", "preferredCameraMode", "createdAt", "updatedAt"]
    },
    "ProjectBookmark": {
      "title": "ProjectBookmark",
      "description": "User-saved portfolio project bookmark with optional review note.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "projectId": {
          "type": "string",
          "enum": ["alumni-management-system", "student-module", "aether-routine", "predictive-te-sr"],
          "description": "Portfolio project identifier."
        },
        "projectTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Human-readable project title."
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Optional user review note for the saved project."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": ["ownerId", "projectId", "projectTitle", "note", "createdAt", "updatedAt"]
    },
    "PortfolioInquiry": {
      "title": "PortfolioInquiry",
      "description": "Contact inquiry persisted to Firestore by an authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Submitter Firebase Auth UID."
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Sender full name."
        },
        "senderEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Sender email address."
        },
        "topic": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Inquiry subject or topic."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Inquiry message body."
        },
        "deliveryMethod": {
          "type": "string",
          "enum": ["firestore", "gmail-and-firestore"],
          "description": "How the inquiry was submitted."
        },
        "status": {
          "type": "string",
          "enum": ["submitted", "reviewed"],
          "description": "Lifecycle status of the inquiry."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": ["ownerId", "senderName", "senderEmail", "topic", "message", "deliveryMethod", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and 3D studio preferences, owned strictly by {userId}."
    },
    "/users/{userId}/bookmarks/{projectId}": {
      "schema": { "$ref": "#/entities/ProjectBookmark" },
      "description": "Saved project bookmarks and notes scoped under the parent user document."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/PortfolioInquiry" },
      "description": "Authenticated portfolio contact inquiries readable by the submitter or verified owner admin."
    }
  }
}
